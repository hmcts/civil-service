<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CancelUnissuedClaimSpec" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.23.0">
  <bpmn:process id="CANCEL_UNISSUED_CLAIM_SPEC_PROCESS_ID" name="Cancel unissued claim spec" isExecutable="true" camunda:historyTimeToLive="P90D">
    <bpmn:startEvent id="StartEvent_CancelUnissuedClaimSpec" name="Start">
      <bpmn:outgoing>Flow_StartToStartBusinessProcess</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CancelUnissuedClaimSpec" messageRef="Message_CancelUnissuedClaimSpec" />
    </bpmn:startEvent>
    <bpmn:callActivity id="StartBusinessProcess_CancelUnissuedClaimSpec" name="Start Business Process" calledElement="StartBusinessProcess">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToStartBusinessProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_StartBusinessProcessToGateway</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Abort_CancelUnissuedClaimSpec" name="Abort" attachedToRef="StartBusinessProcess_CancelUnissuedClaimSpec">
      <bpmn:outgoing>Flow_AbortToAbortEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_CancelUnissuedClaimSpec" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="AbortEnd_CancelUnissuedClaimSpec">
      <bpmn:incoming>Flow_AbortToAbortEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_DashboardServiceEnabled">
      <bpmn:incoming>Flow_StartBusinessProcessToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DashboardServiceEnabled</bpmn:outgoing>
      <bpmn:outgoing>Flow_DashboardServiceDisabled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GenerateDashboardNotificationsCancelUnissuedClaimSpec" name="Dashboard Notifications" camunda:type="external" camunda:topic="dashboardNotifications">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="caseEvent">DASHBOARD_NOTIFICATION_EVENT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DashboardServiceEnabled</bpmn:incoming>
      <bpmn:outgoing>Flow_DashboardToEndBusinessProcess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="EndBusinessProcess_CancelUnissuedClaimSpec" name="End Business Process" calledElement="EndBusinessProcess">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="variables" value="all" />
        </camunda:properties>
        <camunda:in variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DashboardToEndBusinessProcess</bpmn:incoming>
      <bpmn:incoming>Flow_DashboardServiceDisabled</bpmn:incoming>
      <bpmn:outgoing>Flow_EndBusinessProcessToEnd</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_CancelUnissuedClaimSpec">
      <bpmn:incoming>Flow_EndBusinessProcessToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToStartBusinessProcess" sourceRef="StartEvent_CancelUnissuedClaimSpec" targetRef="StartBusinessProcess_CancelUnissuedClaimSpec" />
    <bpmn:sequenceFlow id="Flow_AbortToAbortEnd" sourceRef="Abort_CancelUnissuedClaimSpec" targetRef="AbortEnd_CancelUnissuedClaimSpec" />
    <bpmn:sequenceFlow id="Flow_StartBusinessProcessToGateway" sourceRef="StartBusinessProcess_CancelUnissuedClaimSpec" targetRef="Gateway_DashboardServiceEnabled" />
    <bpmn:sequenceFlow id="Flow_DashboardServiceEnabled" name="Dashboard Service Enabled" sourceRef="Gateway_DashboardServiceEnabled" targetRef="GenerateDashboardNotificationsCancelUnissuedClaimSpec">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!empty flowFlags.DASHBOARD_SERVICE_ENABLED &amp;&amp; flowFlags.DASHBOARD_SERVICE_ENABLED}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DashboardServiceDisabled" name="Dashboard Service Disabled" sourceRef="Gateway_DashboardServiceEnabled" targetRef="EndBusinessProcess_CancelUnissuedClaimSpec">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${empty flowFlags.DASHBOARD_SERVICE_ENABLED || !flowFlags.DASHBOARD_SERVICE_ENABLED}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DashboardToEndBusinessProcess" sourceRef="GenerateDashboardNotificationsCancelUnissuedClaimSpec" targetRef="EndBusinessProcess_CancelUnissuedClaimSpec" />
    <bpmn:sequenceFlow id="Flow_EndBusinessProcessToEnd" sourceRef="EndBusinessProcess_CancelUnissuedClaimSpec" targetRef="End_CancelUnissuedClaimSpec" />
  </bpmn:process>
