    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LrApplicant_ToRpa" sourceRef="NotifyApplicantSolicitorBSLifted" targetRef="NotifyRpaBsLifted" />

    <bpmn:serviceTask id="NotifyRpaBsLifted" name="Notify RPA on Continuous Feed" camunda:type="external" camunda:topic="processCaseEvent">
