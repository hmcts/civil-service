    <bpmn:sequenceFlow id="Flow_LrDef1_ToClaimant" sourceRef="NotifyRespondentSolicitorBSLifted" targetRef="Gateway_Claimant" />

    <bpmn:exclusiveGateway id="Gateway_Claimant" name="Claimant LiP?">
