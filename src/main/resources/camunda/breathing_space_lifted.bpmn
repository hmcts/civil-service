      <bpmn:outgoing>Flow_Def1_Lr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Def1_Lip" name="LiP Defendant1" sourceRef="Gateway_Defendant1" targetRef="BreathingSpaceLiftedNotifyLipRespondent1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!empty flowFlags.UNREPRESENTED_DEFENDANT_ONE &amp;&amp; flowFlags.UNREPRESENTED_DEFENDANT_ONE}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Def1_Lr" name="LR Defendant1" sourceRef="Gateway_Defendant1" targetRef="NotifyRespondentSolicitorBSLifted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${empty flowFlags.UNREPRESENTED_DEFENDANT_ONE || (!empty flowFlags.UNREPRESENTED_DEFENDANT_ONE &amp;&amp; !flowFlags.UNREPRESENTED_DEFENDANT_ONE)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="BreathingSpaceLiftedNotifyLipRespondent1" name="Notify LiP respondent 1" camunda:type="external" camunda:topic="processCaseEvent">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="caseEvent">NOTIFY_LIP_RESPONDENT1_BREATHING_SPACE_LIFTED</camunda:inputParameter>
