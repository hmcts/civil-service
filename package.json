{
  "name": "civil-service-bpmn-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js tooling for rendering Camunda BPMN diagrams in CI (not the main application).",
  "type": "module",
  "scripts": {
    "render:bpmn": "node scripts/render-bpmn-diagrams.mjs",
    "test:definitions": "mocha 'ccd-definition/test/definitions/**/*.test.js'",
    "test:cutover": "mocha 'scripts/cutover/test/**/*.test.mjs'",
    "cutover:seed": "node scripts/cutover/seed.mjs",
    "cutover:check-db": "node scripts/cutover/check-db.mjs",
    "cutover:verify-cases": "node scripts/cutover/verify-cases.mjs",
    "cutover:verify-search": "node scripts/cutover/verify-search.mjs",
    "cutover:verify-tasks": "node scripts/cutover/verify-tasks.mjs",
    "cutover:verify-writes": "node scripts/cutover/verify-writes.mjs"
  },
  "dependencies": {
    "bpmn-to-image": "0.10.0"
  },
  "devDependencies": {
    "chai": "6.3.0",
    "lodash": "4.18.1",
    "mocha": "12.0.3",
    "puppeteer": "25.19.0"
  },
  "overrides": {
    "puppeteer": "$puppeteer",
    "basic-ftp": "6.2.6",
    "js-yaml": "5.5.0",
    "ip-address": "10.7.6",
    "ws": "8.23.0",
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
