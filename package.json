{
  "name": "civil-service-bpmn-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js tooling for rendering Camunda BPMN diagrams in CI (not the main application).",
  "type": "module",
  "scripts": {
    "render:bpmn": "node scripts/render-bpmn-diagrams.mjs",
    "test:definitions": "mocha 'ccd-definition/test/definitions/**/*.test.js'"
  },
  "dependencies": {
    "bpmn-to-image": "0.10.0"
  },
  "devDependencies": {
    "chai": "6.3.0",
    "lodash": "4.18.1",
    "mocha": "12.0.3",
    "puppeteer": "25.16.0"
  },
  "overrides": {
    "puppeteer": "$puppeteer",
    "basic-ftp": "6.2.3",
    "js-yaml": "5.5.0",
    "ip-address": "10.7.5",
    "ws": "8.22.0",
    "glob": "14.0.5",
    "minimatch": "11.0.8"
  }
}
