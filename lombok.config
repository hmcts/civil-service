config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
# Lombok 1.18.44+ can generate @Jacksonized code for Jackson 2 or Jackson 3, and warns until one
# is chosen (which -Werror turns into a build failure). The service is on Jackson 2.
lombok.jacksonized.jacksonVersion += 2
# Lombok 1.18.40+ no longer copies Jackson annotations such as @JsonProperty from fields onto the
# generated getters and setters. Keep copying them so JSON (de)serialisation of the case data
# doesn't change with the upgrade.
lombok.copyJacksonAnnotationsToAccessors = true
