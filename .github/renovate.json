{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/London",
  "automergeSchedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "platformAutomerge": false,
  "schedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.github.hmcts:core-case-data-store-client"
      ],
      "allowedVersions": "<6.0.0",
      "description": "Version 6 requires Spring Boot 4 and Jackson 3; retain the compatible client until the service migrates"
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:auth-checker-lib"
      ],
      "allowedVersions": "<3.2.0",
      "description": "Version 3.2 requires Spring Boot 4; retain the compatible client until the service migrates"
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:ccd-case-document-am-client"
      ],
      "allowedVersions": "<1.60.0",
      "description": "Version 1.60.0 requires Spring Boot 4; retain the compatible client until the service migrates"
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/pact/"
      ]
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:auth-checker-lib",
        "com.github.hmcts:payments-java-client",
        "com.github.hmcts:ccd-case-document-am-client",
        "com.github.hmcts:core-case-data-store-client"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "description": "Restrict HMCTS library upgrades to minor/patch versions. Major versions may introduce incompatibilities with Spring Boot or other core dependencies (e.g., ccd-case-document-am-client v1.60.0 requires Spring Boot 4.0.6, incompatible with project's Spring Boot 3.3.7)"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "Camunda updates",
      "groupSlug": "camunda",
      "automerge": false,
      "description": "Camunda upgrades are isolated in their own group and require manual review to prevent build failures",
      "matchPackageNames": [
        "/^org\\.camunda\\.bpm/"
      ]
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "Spring Boot and related updates",
      "groupSlug": "spring-boot-related",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/org.springframework/",
        "/org.springdoc/",
        "/spring-boot/",
        "/spring-cloud/",
        "/jakarta.persistence/",
        "/org.hibernate/"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform updates",
      "groupSlug": "terraform",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "Lombok updates",
      "groupSlug": "lombok",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/org.projectlombok/",
        "/io.freefair.lombok/"
      ]
    }
  ]
}
