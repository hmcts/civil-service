{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/London",
  "automergeSchedule": [
    "after 7am and before 9am every weekday",
    "after 5pm and before 8pm every weekday"
  ],
  "platformAutomerge": false,
  "schedule": [
    "after 7am and before 9am every weekday",
    "after 5pm and before 8pm every weekday"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.github.hmcts:core-case-data-store-client"
      ],
      "allowedVersions": "<5.4.0",
      "description": "Version 5.4.0 already needs Spring Boot 4 (it requires org.springframework.boot:spring-boot-http-converter), as does version 6 with Jackson 3; retain the compatible client until the service migrates"
    },
    {
      "matchPackageNames": [
        "org.springframework.cloud:spring-cloud-dependencies"
      ],
      "allowedVersions": "<2025.1.0",
      "description": "Spring Cloud 2025.1 targets Spring Boot 4: its OpenFeign loads org.springframework.boot.http.converter.autoconfigure.ClientHttpMessageConvertersCustomizer, which Boot 3.5 lacks, so the application context fails to start"
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:send-letter-client"
      ],
      "allowedVersions": "<6.0.0",
      "description": "Version 6 is built for Java 25; the service still compiles for Java 21"
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:auth-checker-lib"
      ],
      "allowedVersions": "<3.2.0",
      "description": "Version 3.2 requires Spring Boot 4; retain the compatible client until the service migrates"
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:ccd-case-document-am-client"
      ],
      "allowedVersions": "<1.60.0",
      "description": "Version 1.60.0 requires Spring Boot 4; retain the compatible client until the service migrates"
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/pact/"
      ]
    },
    {
      "matchPackageNames": [
        "com.github.hmcts:auth-checker-lib",
        "com.github.hmcts:payments-java-client",
        "com.github.hmcts:ccd-case-document-am-client",
        "com.github.hmcts:core-case-data-store-client"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "description": "Restrict HMCTS library upgrades to minor/patch versions. Major versions may introduce incompatibilities with Spring Boot or other core dependencies (e.g., ccd-case-document-am-client v1.60.0 requires Spring Boot 4.0.6, incompatible with project's Spring Boot 3.3.7)"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the Terraform CLI version (infrastructure/.terraform-version) out of the npm non-major group; large jumps can affect state and providers, so review and merge manually",
      "matchManagers": [
        "terraform-version"
      ],
      "groupName": "Terraform version",
      "groupSlug": "terraform-version",
      "automerge": false
    },
    {
      "description": "Keep the cnp-jenkins-library @Library bump in Jenkinsfiles out of the npm non-major group so pipeline changes are tested on their own",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "groupName": "Jenkins library",
      "groupSlug": "jenkins-library"
    },
    {
      "groupName": "Camunda updates",
      "groupSlug": "camunda",
      "automerge": false,
      "description": "Camunda upgrades are isolated in their own group and require manual review to prevent build failures",
      "matchPackageNames": [
        "/^org\\.camunda\\.bpm/"
      ]
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "DTSCCI-7065: Hold CCD chart updates until the chart size regression is resolved and the packaged civil-service chart is safely below the size limit",
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "ccd"
      ],
      "enabled": false
    },
    {
      "description": "Require manual review of AAC chart updates because the chart also bundles CCD",
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "aac-manage-case-assignment"
      ],
      "groupName": "AAC chart updates",
      "groupSlug": "aac-chart",
      "automerge": false
    },
    {
      "groupName": "Spring Boot and related updates",
      "groupSlug": "spring-boot-related",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/org.springframework/",
        "/org.springdoc/",
        "/spring-boot/",
        "/spring-cloud/",
        "/jakarta.persistence/",
        "/org.hibernate/"
      ]
    },
    {
      "description": "No Spring major updates until the Spring Boot 4 migration (the spring-boot-4 branch) lands: the major group needs Boot 4 and cannot compile on master, so its PR fails on every rebase",
      "matchPackageNames": [
        "/org.springframework/",
        "/org.springdoc/",
        "/spring-boot/",
        "/spring-cloud/",
        "/jakarta.persistence/",
        "/org.hibernate/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform updates",
      "groupSlug": "terraform",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "Lombok updates",
      "groupSlug": "lombok",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/org.projectlombok/",
        "/io.freefair.lombok/"
      ]
    }
  ]
}
