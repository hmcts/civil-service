withNightlyPipeline(type, product, component) {
  env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR = 'playwright-functional-test-results'
  env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_PROJECT_DIR = 'civil-service-nightly'
  env.GRADLE_OPTS = "-Dorg.gradle.workers.max=3"
  env.FORCE_GREEN_BUILD=params.FORCE_GREEN_BUILD
  env.RUN_FAILED_TESTS=params.RUN_FAILED_TESTS
  env.PLAYWRIGHT_WORKERS=params.PLAYWRIGHT_WORKERS
  env.PLAYWRIGHT_RETRIES=params.PLAYWRIGHT_RETRIES
  env.PLAYWRIGHT_EXUI_RETRIES=params.PLAYWRIGHT_EXUI_RETRIES
  env.PLAYWRIGHT_IDAM_RETRIES=params.PLAYWRIGHT_IDAM_RETRIES
  env.PLAYWRIGHT_RUN_ACCESSIBILITY_TESTS=params.PLAYWRIGHT_RUN_ACCESSIBILITY_TESTS
  env.PLAYWRIGHT_RUN_CUI_USER_SETUP=params.PLAYWRIGHT_RUN_CUI_USER_SETUP
  env.PLAYWRIGHT_RUN_EXUI_USER_DATA_SETUP=params.PLAYWRIGHT_RUN_EXUI_USER_DATA_SETUP
  env.PLAYWRIGHT_RUN_CUI_USER_DATA_SETUP=params.PLAYWRIGHT_RUN_CUI_USER_DATA_SETUP
  env.PLAYWRIGHT_RUN_DATA_SETUP=params.PLAYWRIGHT_RUN_DATA_SETUP
  env.PLAYWRIGHT_WA_ENABLED=params.PLAYWRIGHT_WA_ENABLED
  env.PLAYWRIGHT_UNASSIGN_CASES = true
  env.PLAYWRIGHT_TEST_SPEED=params.PLAYWRIGHT_TEST_SPEED

  def prNumber = params.PR_NUMBER?.trim()
  def resolvePreviewUrl = { String value, String paramName ->
    if (value?.contains('{PR_NUMBER}')) {
      if (!prNumber) {
        error "Parameter ${paramName} contains '{PR_NUMBER}' but PR_NUMBER was not provided."
      }
      return value.replace('{PR_NUMBER}', prNumber)
    }
    return value
  }

  def frontendUrl = resolvePreviewUrl(params.FRONTEND_URL, 'FRONTEND_URL')
  def ccdDataStoreUrl = resolvePreviewUrl(params.CCD_DATA_STORE_URL, 'CCD_DATA_STORE_URL')
  def civilServiceUrl = resolvePreviewUrl(params.CIVIL_SERVICE_URL, 'CIVIL_SERVICE_URL')
  def aacApiUrl = resolvePreviewUrl(params.AAC_API_URL, 'AAC_API_URL')

  env.URL=frontendUrl
  env.DM_STORE_URL=params.DM_STORE_URL
  env.IDAM_API_URL=params.IDAM_API_URL
  env.IDAM_TEST_SUPPORT_API_URL=params.IDAM_TEST_SUPPORT_API_URL
  env.SERVICE_AUTH_PROVIDER_API_BASE_URL = params.SERVICE_AUTH_PROVIDER_API_BASE_URL
  env.WA_TASK_MGMT_URL = params.WA_TASK_MGMT_URL
  env.CCD_DATA_STORE_URL = ccdDataStoreUrl
  env.CIVIL_SERVICE_URL = civilServiceUrl
  env.WAIT_FOR_TIMEOUT_MS = params.WAIT_FOR_TIMEOUT_MS
  env.URL_FOR_SECURITY_SCAN = params.CIVIL_SERVICE_URL
  env.TESTS_FOR_ACCESSIBILITY = true
  env.NIGHTLY_RUN = true
  env.AAC_API_URL = aacApiUrl
  env.UNASSIGN_CASES = true
  overrideVaultEnvironments([
   'aat': params.ENVIRONMENT == 'preview' ? 'aat' : params.ENVIRONMENT
  ])
  loadVaultSecrets(secrets)

  boolean forceGreenBuild = env.FORCE_GREEN_BUILD.toBoolean();
  boolean runFailedTests = env.RUN_FAILED_TESTS.toBoolean();

  if(!forceGreenBuild) {
    afterAlways('DependencyCheckNightly') {
      sh """
        ./bin/pull-latest-civil-ccd-files.sh ${ccdBranch}
      """
      yarnBuilder.yarn('install-dependencies')

      if(runFailedTests) {
        copyPrevPlaywrightLastRun()
        copyPrevTestFilesReport("${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_PROJECT_DIR}/playwrightTestFilesReport.json")
      }

      boolean playwrightSetupPassed = true
      boolean flowInterrupted = false
      boolean lastRunPassed = env.RUN_FAILED_TESTS.toBoolean() && checkHasPlaywrightLastRunStatus('passed');
      boolean playwrightRunSetup =
        env.PLAYWRIGHT_RUN_DATA_SETUP.toBoolean() ||
        env.PLAYWRIGHT_RUN_EXUI_USER_DATA_SETUP.toBoolean() ||
        env.PLAYWRIGHT_RUN_CUI_USER_DATA_SETUP.toBoolean() ||
        env.PLAYWRIGHT_RUN_CUI_USER_SETUP.toBoolean();

      stage('Playwright test setup') {
        try {
          if(playwrightRunSetup) {
            sh './playwright-e2e/scripts/playwright-run-civil-service-setup.sh'
          }
        } catch (Exception error) {
          if(error instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            flowInterrupted = true
          }
          if(playwrightRunSetup) {
            playwrightSetupPassed=false
          }
          unstable(message: "${STAGE_NAME} is unstable: " + error.toString())
        } finally {
          if(playwrightRunSetup && !lastRunPassed) {
            yarnBuilder.yarn('test:playwright:bootstrap:generate-report')
          }
        }
      }

      stage('Playwright full functional test') {
        try {
          if(flowInterrupted) {
            throw new org.jenkinsci.plugins.workflow.steps.FlowInterruptedException()
          }
          if(playwrightSetupPassed) {
            sh './playwright-e2e/scripts/playwright-run-civil-service-nightly-tests.sh'
          }
        } catch (Exception error) {
          if(error instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            flowInterrupted = true
          }
          unstable(message: "${STAGE_NAME} is unstable: " + error.toString())
        } finally {
          if(playwrightSetupPassed && !lastRunPassed) {
            copyPreviousAllureHistory('allure-functional-history', 'playwright-allure-functional-results');
            sh 'cp playwright-categories.json playwright-allure-functional-results/categories.json'
            yarnBuilder.yarn('test:playwright:functional:generate-report')
            publishAllureReport(
              'playwright-allure-functional-report', 
              'Playwright Allure Functional Report', 
              'allure-functional-history'
            )
          }
          archiveArtifacts allowEmptyArchive: true, artifacts: "${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/**/*"
        }
      }

      if(playwrightRunSetup) {
        stage('Playwright test teardown') {
          try {
            sh './playwright-e2e/scripts/playwright-run-civil-service-teardown.sh'
          } catch (Exception error) {
            unstable(message: "${STAGE_NAME} is unstable: " + error.toString())
          } finally {
            if(!lastRunPassed) {
              copyPreviousAllureHistory('allure-bootstrap-history', 'playwright-allure-bootstrap-results');
              sh 'cp playwright-categories.json playwright-allure-bootstrap-results/categories.json'
              yarnBuilder.yarn('test:playwright:bootstrap:generate-report')
              publishAllureReport(
                'playwright-allure-bootstrap-report', 
                'Playwright Allure Bootstrap Report', 
                'allure-bootstrap-history'
              )
            }
          }
        }
      }
    }

    if(!runFailedTests && !forceGreenBuild) {
      enableFortifyScan()

      afterAlways('fortify-scan') {
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: '**/Fortify Scan/**/*'
      }
    }

    boolean hasFailedTestFiles = false;

    if(!forceGreenBuild) {
      before('fullFunctionalTest') {
        if(runFailedTests) {
          copyPrevTestFilesReport("test-results/functional/testFilesReport.json")
          hasFailedTestFiles = checkHasFailedTestFiles()
        }
        if (!runFailedTests || !hasFailedTestFiles) {
          copyPreviousAllureHistory('allure-functional-history', 'allure-functional-results');
        }
      }
    }
    
    enableFullFunctionalTest(200)

    if(!forceGreenBuild) {
      afterAlways('fullFunctionalTest') {
        if (!runFailedTests || !hasFailedTestFiles) {
          yarnBuilder.yarn('test:generate-report')
          publishAllureReport(
            'allure-functional-report',
            'Allure Functional Report',
            'allure-functional-history',
          )
        }
        archiveArtifacts allowEmptyArchive: true, artifacts: 'test-results/functional/**/*'
        env.TESTS_FOR_ACCESSIBILITY = false
      }
    }
  }
}
