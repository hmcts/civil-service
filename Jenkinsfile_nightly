@Library("Infrastructure")

def type = "java"
def product = "civil"
def component = "service"
def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)
def ccdBranch = "master"

static Map<String, Object> secret(String secretName, String envVariable) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   envVariable: envVariable
  ]
}


void publishAllureReport(String reportDir, String reportName, String historyArchiveDir) {
  publishHTML([
    allowMissing: true,
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: reportDir,
    reportFiles: 'index.html',
    reportName: reportName
  ])
  sh "cp -r ./${reportDir}/history/ ./${historyArchiveDir}"
  archiveArtifacts artifacts: "${historyArchiveDir}/**", fingerprint: true
}

def copyPreviousAllureHistory(historyDir, resultsDir) {
  def buildFound = false
  def buildNumber = currentBuild.previousBuild ? currentBuild.previousBuild.number : 0
  def minBuildNumber = ((buildNumber - 8) > 0) ? buildNumber - 8 : 0
  while (!buildFound && buildNumber > minBuildNumber) {
    try {
      copyArtifacts projectName: env.JOB_NAME, selector: specific("${buildNumber}"), filter: "**/${historyDir}/**", target: "${resultsDir}"
      sh "mv ${resultsDir}/${historyDir} ${resultsDir}/history"
      buildFound = true
    } catch (Exception error) {
      echo "artifact not found: " + error.toString()
      buildNumber--
    }
  }
}

def copyPrevTestFilesReport(reportFilePath) {
  def buildFound = false
  def buildNumber = currentBuild.previousBuild ? currentBuild.previousBuild.number : 0
  def minBuildNumber = ((buildNumber - 8) > 0) ? buildNumber - 8 : 0
  while (!buildFound && buildNumber > minBuildNumber) {
    try {
      copyArtifacts projectName: env.JOB_NAME, selector: specific("${buildNumber}"), filter: reportFilePath
      buildFound = true
    } catch (Exception error) {
      echo "artifact not found: " + error.toString()
      buildNumber--
    }
  }
}

def checkHasPlaywrightLastRunStatus(expectedStatuses) {
  def lastRunStatus = sh(
    script: "jq -r '.status // empty' ${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_PROJECT_DIR}/.last-run.json",
    returnStdout: true
  ).trim()
  def statuses = expectedStatuses instanceof Collection ? expectedStatuses : [expectedStatuses]
  return statuses.contains(lastRunStatus)
}

def checkHasFailedTestFiles() {
  def failedTestFiles = sh(
    script: "jq -r '.failedTestFiles | length' test-results/functional/testFilesReport.json",
    returnStdout: true
  ).trim()
  return failedTestFiles == '0'
}

def copyPrevPlaywrightLastRun() {
  def buildFound = false
  def buildNumber = currentBuild.previousBuild ? currentBuild.previousBuild.number : 0
  def minBuildNumber = ((buildNumber - 8) > 0) ? buildNumber - 8 : 0
  while (!buildFound && buildNumber > minBuildNumber) {
    try {
      sh "rm -rf ${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_PROJECT_DIR}"
      copyArtifacts(
        projectName: env.JOB_NAME,
        selector: specific("${buildNumber}"),
        filter: "${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_DIR}/${env.PLAYWRIGHT_FUNCTIONAL_TEST_RESULTS_PROJECT_DIR}/.last-run.json"
      )
      if (!checkHasPlaywrightLastRunStatus(['passed', 'failed'])) {
        throw new Exception(
          "Skipping copied .last-run.json from build ${buildNumber} because status was not 'passed' or 'failed'"
        )
      }
      buildFound = true
    } catch (Exception error) {
      echo "artifact not found: " + error.toString()
      buildNumber--
    }
  }
}

